{
  "name": "dj-phee-react-app",
  "version": "1.0.0",
  "private": true,
  "description": "A React application for booking DJ Phee for events.",
  "scripts": {
    "start": "export NODE_OPTIONS=--openssl-legacy-provider && react-scripts start",
    "build": "export NODE_OPTIONS=--openssl-legacy-provider && react-scripts build && npx react-snap",
    "test": "export NODE_OPTIONS=--openssl-legacy-provider && react-scripts test",
    "eject": "react-scripts eject",
    "deploy:firebase": "npm run build && npx firebase-tools deploy --only hosting"
  },
  "dependencies": {
    "@loadable/component": "^5.15.3",
    "@emailjs/browser": "^4.4.1",
    "date-fns": "^4.1.0",
    "emailjs-com": "^2.6.4",
    "firebase": "^12.0.0",
    "flatpickr": "^4.6.9",
    "react-datepicker": "^8.4.0",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.1",
    "react-slider": "^2.0.6",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "eslint": "^7.32.0",
    "eslint-plugin-react": "^7.27.1",
    "gh-pages": "^6.3.0",
    "react-scripts": "^5.0.1",
    "react-snap": "^1.23.0"
  },
  "keywords": [
    "react",
    "dj",
    "booking",
    "events"
  ],
  "author": "Your Name",
  "license": "MIT",
  "overrides": {
    "minimist": "^1.2.8",
    "mkdirp": "^1.0.4",
    "node-fetch": "^2.6.11",
    "qs": "^6.11.2",
    "body-parser": "^1.20.3",
    "cookie": "^0.7.2",
    "send": "^0.18.0",
    "serve-static": "^1.15.0",
    "path-to-regexp": "^0.1.12",
    "nth-check": "^2.1.1",
    "html-minifier": "^4.0.0",
    "express": "^4.21.1",
    "postcss": "^8.4.38",
    "webpack-dev-server": "^4.15.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "reactSnap": {
    "crawl": false,
    "include": ["/"],
    "skipThirdPartyRequests": true,
    "inlineCss": false,
    "removeThirdPartyScripts": false,
    "puppeteerPageGotoOptions": {
      "waitUntil": "load",
      "timeout": 60000
    }
  }
}
